{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.{{ github_org }}/{{ project_name }}",
  "title": "{{ human_name }}",
  "description": "{{ domain_description }}",
  "version": "0.1.0",
  "websiteUrl": "https://{{ github_org }}.github.io/{{ project_name }}/",
  "repository": {
    "url": "https://github.com/{{ github_org }}/{{ project_name }}",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "{{ pypi_name }}",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "{{ env_prefix }}_KV_STORE_URL",
          "description": "Persistent-state backend URL shared by every pvl-core subsystem that needs state. `memory://` is in-process and lost on restart; `file:///path` persists on one server; `redis://`, `dynamodb://` and `mongodb://` each need their matching extra. Defaults to `file:///data/state` when unset.",
          "default": "file:///data/state"
        },
        {
          "name": "{{ env_prefix }}_SERVER_NAME",
          "description": "Rename this server instance; defaults to the project name."
        },
        {
          "name": "{{ env_prefix }}_INSTANCE_DESCRIPTION",
          "description": "Concise routing context that distinguishes this deployment's material or responsibility."
        },
        {
          "name": "{{ env_prefix }}_INSTRUCTIONS_EXTRA",
          "description": "Deployment-specific behavioral policy added to the generated MCP instructions."
        },
        {
          "name": "{{ env_prefix }}_INSTRUCTIONS",
          "description": "Legacy: replaces all generated MCP instructions (deprecated; use _INSTANCE_DESCRIPTION for routing and _INSTRUCTIONS_EXTRA for policy)."
        },
        {
          "name": "FASTMCP_LOG_LEVEL",
          "description": "Log level for FastMCP internals and app loggers (DEBUG / INFO / WARNING / ERROR / CRITICAL). The -v CLI flag overrides to DEBUG.",
          "default": "INFO",
          "choices": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        {
          "name": "FASTMCP_ENABLE_RICH_LOGGING",
          "description": "Set false for plain or structured JSON log output.",
          "format": "boolean",
          "default": "true"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "{{ docker_registry }}/{{ project_name }}:v0.1.0",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:{--port}/mcp"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--port",
          "default": "8000",
          "description": "Port for the HTTP transport"
        }
      ],
      "environmentVariables": [
        {
          "name": "{{ env_prefix }}_BASE_URL",
          "description": "Public base URL of the deployed server, e.g. `https://mcp.example.com`. Required for OIDC. Also the fallback source of the MCP Apps domain when `app_domain` is unset.",
          "placeholder": "https://mcp.example.com"
        },
        {
          "name": "{{ env_prefix }}_BEARER_TOKEN",
          "description": "Single shared bearer token; enables bearer auth unless `bearer_tokens_file` is set, which takes precedence.",
          "placeholder": "<secret>",
          "isSecret": true
        },
        {
          "name": "{{ env_prefix }}_OIDC_CONFIG_URL",
          "description": "OIDC discovery document URL, e.g. `https://auth.example.com/.well-known/openid-configuration`.",
          "placeholder": "https://auth.example.com/.well-known/openid-configuration"
        },
        {
          "name": "{{ env_prefix }}_OIDC_CLIENT_ID",
          "description": "OIDC client identifier registered with the provider.",
          "placeholder": "mcp-client"
        },
        {
          "name": "{{ env_prefix }}_OIDC_CLIENT_SECRET",
          "description": "OIDC client secret registered with the provider.",
          "placeholder": "your-client-secret",
          "isSecret": true
        },
        {
          "name": "{{ env_prefix }}_OIDC_AUDIENCE",
          "description": "Expected `aud` claim; tokens issued for another audience are rejected.",
          "placeholder": "mcp-api"
        },
        {
          "name": "{{ env_prefix }}_OIDC_REQUIRED_SCOPES",
          "description": "Scopes a caller must present, space- or comma-separated. Defaults to `openid` in oidc-proxy mode.",
          "default": "openid"
        },
        {
          "name": "{{ env_prefix }}_OIDC_ADVERTISED_SCOPES",
          "description": "Scopes advertised to clients in protected-resource metadata, space- or comma-separated. Overrides the default `openid offline_access`; the required scopes above are always added on top.",
          "default": "openid offline_access"
        },
        {
          "name": "{{ env_prefix }}_OIDC_JWT_SIGNING_KEY",
          "description": "Signing key for issued JWTs; used in oidc-proxy mode only. When unset, the key is derived deterministically from `oidc_client_secret`, so tokens survive a restart — but rotating that secret invalidates every issued token. Set this explicitly to decouple token validity from secret rotation. Generate with `openssl rand -hex 32`.",
          "default": "derived",
          "isSecret": true
        },
        {
          "name": "{{ env_prefix }}_OIDC_VERIFY_ACCESS_TOKEN",
          "description": "Validate the access token instead of the id token.",
          "format": "boolean",
          "default": "false"
        },
        {
          "name": "{{ env_prefix }}_KV_STORE_URL",
          "description": "Persistent-state backend URL shared by every pvl-core subsystem that needs state. `memory://` is in-process and lost on restart; `file:///path` persists on one server; `redis://`, `dynamodb://` and `mongodb://` each need their matching extra. Defaults to `file:///data/state` when unset.",
          "default": "file:///data/state"
        },
        {
          "name": "{{ env_prefix }}_APP_DOMAIN",
          "description": "MCP Apps iframe domain, used for CSP sandboxing. Overrides the host derived from `base_url`."
        },
        {
          "name": "{{ env_prefix }}_AUTH_MODE",
          "description": "Explicit auth-mode override, accepting `remote` or `oidc-proxy` (case- and whitespace-insensitive). When unset the mode is auto-detected from which auth variables are set; the override exists because having all four OIDC variables set is ambiguous between those two modes. Other values are ignored with a warning."
        },
        {
          "name": "{{ env_prefix }}_BEARER_TOKENS_FILE",
          "description": "Path to a TOML file mapping bearer tokens to subjects; overrides the single-token `bearer_token` mode.",
          "format": "filepath",
          "placeholder": "/etc/{{ project_name }}/tokens.toml"
        },
        {
          "name": "{{ env_prefix }}_BEARER_DEFAULT_SUBJECT",
          "description": "Subject assigned to the single-token bearer mode; ignored when `bearer_tokens_file` is set, since mapped mode carries per-token subjects.",
          "default": "bearer-anon"
        },
        {
          "name": "{{ env_prefix }}_SERVER_NAME",
          "description": "Rename this server instance; defaults to the project name."
        },
        {
          "name": "{{ env_prefix }}_INSTANCE_DESCRIPTION",
          "description": "Concise routing context that distinguishes this deployment's material or responsibility."
        },
        {
          "name": "{{ env_prefix }}_INSTRUCTIONS_EXTRA",
          "description": "Deployment-specific behavioral policy added to the generated MCP instructions."
        },
        {
          "name": "{{ env_prefix }}_INSTRUCTIONS",
          "description": "Legacy: replaces all generated MCP instructions (deprecated; use _INSTANCE_DESCRIPTION for routing and _INSTRUCTIONS_EXTRA for policy)."
        },
        {
          "name": "{{ env_prefix }}_HTTP_PATH",
          "description": "Mount path for the MCP endpoint.",
          "default": "/mcp"
        },
        {
          "name": "PUID",
          "description": "Run the server process as this UID; the container entrypoint chowns writable paths to match.",
          "format": "number",
          "default": "1000"
        },
        {
          "name": "PGID",
          "description": "Run the server process as this GID; pair with PUID to match the owner of a mounted volume.",
          "format": "number",
          "default": "1000"
        },
        {
          "name": "{{ env_prefix }}_ACL_PATH",
          "description": "Subject-to-scope ACL file (TOML), for bearer and any auth mode.",
          "format": "filepath",
          "placeholder": "/etc/{{ project_name }}/acl.toml"
        },
        {
          "name": "{{ env_prefix }}_AUTHZ_CLAIM",
          "description": "OIDC claim to read scopes from, e.g. groups. Identity mapping when IdP group names already match scope names."
        },
        {
          "name": "{{ env_prefix }}_AUTHZ_GRANTS",
          "description": "Inline-JSON translation map for when group names differ from scope names.",
          "placeholder": "{\"app-writers\": [\"read\", \"write\"], \"app-admins\": [\"*\"]}"
        },
        {
          "name": "FASTMCP_LOG_LEVEL",
          "description": "Log level for FastMCP internals and app loggers (DEBUG / INFO / WARNING / ERROR / CRITICAL). The -v CLI flag overrides to DEBUG.",
          "default": "INFO",
          "choices": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        {
          "name": "FASTMCP_ENABLE_RICH_LOGGING",
          "description": "Set false for plain or structured JSON log output.",
          "format": "boolean",
          "default": "true"
        }
      ]
    }
  ]
}
