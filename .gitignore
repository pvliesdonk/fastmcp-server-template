__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.env
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.npy
*.npz
site/

# Shared agent skills are tracked while other .agents content stays local.
.agents/*
!.agents/skills/

# Claude Code local state — everything under .claude/ except the three
# entries re-included below. skills/ holds symlinks into .agents/skills/,
# template-owned on copier update.
.claude/*
!.claude/skills/
# The SessionStart hook that installs Vale into a Claude Code on the web
# container, and the settings file that registers it. Tracked so a web session
# picks them up from the default branch; the binaries it installs land in
# .claude/tools/, which the rule above keeps ignored.
!.claude/settings.json
!.claude/hooks/

# Git worktrees (superpowers skill convention)
.worktrees/

# Repowise local index cache (never tracked — large binary churn)
.repowise/

# Superpowers subagent-driven-development scratch (briefs, reports, diffs, ledger)
.superpowers/

# Local MCP + scratch artifacts from agent sessions
.mcp.json
# Editor-local config; the only IDE entry here by design, matching
# .gitignore.jinja. Repowise rewrites .vscode/mcp.json and extensions.json on
# every index refresh with no way to turn that off, so they reappear
# indefinitely — and in this repo specifically a dirty tree makes copier mint a
# fresh temp commit per render, so `_commit` differs between two otherwise
# identical renders and the render-twice `diff -r` fails.
.vscode/
full_pr_feedback.json
pr_comments.txt
pr_inline_comments.json
pr_issue_comments.json
