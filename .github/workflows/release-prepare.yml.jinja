# Release-PR flow, half one of two (knope; fastmcp-server-template#406).
# Dispatch this workflow on the ref to release from (`main` for a trunk
# release, `release/X.Y` for an rc or its promotion).  It computes the
# version from conventional commits, stamps the version-coupled files, and
# opens (or refreshes) the release PR against the dispatched ref.  Merging
# that PR is the release decision — release-tag.yml tags the merge commit.
#
# INERT WHILE PSR LIVES (migration P1.0): the interlock step below refuses
# while `[tool.semantic_release]` still exists in the checked-out
# `pyproject.toml`.  The Phase-2 swap that deletes the PSR block is the
# arming action for this flow; until then `release.yml` is the release path.
#
# Operator rules (load-bearing — see release-vision sections 4.1/4.2):
#   * NEVER use GitHub's "Update branch" button on a release PR — it merges
#     the base into the prep branch behind the tool's back and routes around
#     the recreate rule below.  The only refresh is re-dispatching this
#     workflow.
#   * The ruleset's strict required checks already hard-block merging a
#     stale release PR; re-dispatch instead of merging around staleness.
name: Release Prepare

on:
  workflow_dispatch:
    inputs:
      channel:
        description: 'Release channel. auto = rc on release/* branches, stable elsewhere; rc / stable override the derivation (promotion of an rc series IS the explicit stable run on its branch).'
        type: choice
        default: auto
        options:
          - auto
          - rc
          - stable

permissions:
  contents: read

jobs:
  prepare:
    runs-on: ubuntu-latest
    # Per-base buckets, mirroring release.yml's release-${ref} buckets: a
    # backport prepare off release/X.Y must not serialise behind (or cancel)
    # a trunk prepare.  cancel-in-progress stays false — a prepare is short
    # and cancelling one mid-push could leave a half-refreshed release PR.
    concurrency:
      group: release-prepare-{% raw %}${{ github.ref_name }}{% endraw %}
      cancel-in-progress: false
    timeout-minutes: 15
    steps:
      - name: Checkout the dispatched ref (full depth, with tags)
        uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ github.ref_name }}{% endraw %}
          # Full history + tags: knope computes the version from the
          # conventional commits since the last release tag in this ref's
          # ancestry.
          fetch-depth: 0
          fetch-tags: true
          # RELEASE_TOKEN (PAT), persisted for the prep-branch push (M1): a
          # GITHUB_TOKEN-authored release PR triggers no workflows, so the
          # required `CI Success` check would never report and the PR would
          # be unmergeable forever — the same reason copier-update.yml uses
          # this token.
          token: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}

      # INTERLOCK (migration P1.0) — must stay the first step after
      # checkout.  While the PSR block exists, both release paths would be
      # live at once; deleting `[tool.semantic_release]` from pyproject.toml
      # (the Phase-2 swap) is what arms this workflow.
      - name: Refuse while python-semantic-release is still the release path
        run: |
          if grep -q '^\[tool\.semantic_release\]' pyproject.toml; then
            echo "::error::pyproject.toml still carries [tool.semantic_release] — the PSR flow (release.yml) is live and this knope flow is interlocked-inert. The Phase-2 swap that deletes the PSR block is the arming action; until then, release via the Release workflow."
            exit 1
          fi
          echo "interlock: no [tool.semantic_release] block — knope flow is armed"

      # knope-dev/action installs the pinned knope CLI.  Renovate: the
      # action ref is picked up natively; the `version:` input below needs a
      # customManagers regex rule (github-releases, depName knope-dev/knope)
      # to be bumped automatically — until one exists, bump it by hand in
      # lockstep with any knope config-schema change (migration section 5,
      # open question 1).
      - name: Install knope
        uses: knope-dev/action@v2.1.2
        with:
          version: 0.23.0

      - name: Configure git identity
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      # rc by default on release/* branches, stable elsewhere; an explicit
      # channel input overrides.  Deriving the channel PURELY from the
      # branch was live-tested and rejected (release-vision section 4.1): it
      # makes the plain stable promotion run unreachable on the very
      # release/X.Y branch that needs it.
      - name: Derive the release channel
        id: channel
        env:
          CHANNEL: {% raw %}${{ inputs.channel }}{% endraw %}
        run: |
          case "$CHANNEL" in
            rc) flags="--prerelease-label rc" ;;
            stable) flags="" ;;
            *)
              flags=""
              if [[ "$GITHUB_REF_NAME" == release/* ]]; then
                flags="--prerelease-label rc"
              fi
              ;;
          esac
          echo "channel resolved: input=$CHANNEL ref=$GITHUB_REF_NAME flags='${flags}'"
          echo "flags=${flags}" >> "$GITHUB_OUTPUT"

      # knope 0.23.0's CreatePullRequest `base` is a plain string (not
      # templatable — spike-verified), so patch it to the dispatched ref
      # here.  The patched knope.toml stays uncommitted: knope's prepare
      # commit stages only the release files.
      - name: Point the release PR base at the dispatched ref
        run: sed -i "s|^base = .*|base = \"${GITHUB_REF_NAME}\"|" knope.toml

      # ALWAYS recreate the prep branch from the dispatched base — never
      # re-run preparation on a stale prep branch: re-running on
      # already-stamped files does not refuse, it computes the NEXT version
      # on top of the stamped one (the double-bump trap, observed in the
      # spike).  The branch is namespaced per base (slashes sanitized to
      # dashes) so concurrent release PRs on main and release/X.Y coexist,
      # and so prep branches stay outside the release/** ruleset whose
      # non-fast-forward rule would block this force-recreate flow.
      - name: Recreate the prep branch from the dispatched base
        id: prep
        run: |
          branch="knope/prepare/${GITHUB_REF_NAME//\//-}"
          git switch --force-create "$branch"
          echo "branch=${branch}" >> "$GITHUB_OUTPUT"

      # knope's prepare-release workflow (knope.toml): PrepareRelease bumps
      # pyproject.toml/uv.lock and writes the changelog section, the stamp
      # Command rewrites the install-channel manifests (stable only), the
      # commit + force-push Commands publish the prep branch (name via
      # KNOPE_PREP_BRANCH), and CreatePullRequest opens or refreshes the
      # release PR against the base patched above.
      - name: Prepare the release PR
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
          KNOPE_PREP_BRANCH: {% raw %}${{ steps.prep.outputs.branch }}{% endraw %}
        run: knope prepare-release --verbose {% raw %}${{ steps.channel.outputs.flags }}{% endraw %}
