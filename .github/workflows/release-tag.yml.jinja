# Release-PR flow, half two of two (knope; fastmcp-server-template#406).
# Merge = release: when a release PR (head `knope/prepare/<base>`, opened by
# release-prepare.yml) merges, run knope's tag-release workflow on the PR's
# merge commit.  Inside knope.toml the same-source promotion guard
# (scripts/promotion_guard.sh) runs BEFORE the Release step, so a guard
# refusal fails this job with no tag created (release-vision section 4.4 —
# tags are immutable; a refusal must leave nothing behind).
#
# INERT WHILE PSR LIVES (migration P1.0): the interlock step below refuses
# while `[tool.semantic_release]` still exists in the checked-out
# `pyproject.toml` — so a merged prep-named PR cannot invoke Release during
# the additive phase any more than a dispatch can.  The Phase-2 swap that
# deletes the PSR block is the arming action.
name: Release Tag

on:
  pull_request:
    types: [closed]

permissions:
  contents: read

jobs:
  tag:
    # Only merged release PRs; the head-ref prefix is the prep-branch
    # namespace release-prepare.yml creates (per base, so concurrent release
    # PRs on main and release/X.Y stay distinguishable here).
    if: >-
      github.event.pull_request.merged == true &&
      startsWith(github.event.pull_request.head.ref, 'knope/prepare/')
    runs-on: ubuntu-latest
    # Per-base buckets, mirroring release-prepare.yml's.
    concurrency:
      group: release-tag-{% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
      cancel-in-progress: false
    timeout-minutes: 15
    steps:
      - name: Checkout the release PR's merge commit (full depth, with tags)
        uses: actions/checkout@v7
        with:
          # The MERGE COMMIT, not the base branch head: a commit landing on
          # the base between merge and checkout must neither get tagged as
          # the release nor spuriously trip the promotion guard.  The merge
          # commit is exactly what "merging the release PR is the release"
          # promises to tag.
          ref: {% raw %}${{ github.event.pull_request.merge_commit_sha }}{% endraw %}
          # Full history + tags: the promotion guard diffs HEAD against the
          # highest reachable rc tag of the target version.
          fetch-depth: 0
          fetch-tags: true

      # INTERLOCK (migration P1.0) — must stay the first step after
      # checkout; see release-prepare.yml's twin step for the rationale.
      - name: Refuse while python-semantic-release is still the release path
        run: |
          if grep -q '^\[tool\.semantic_release\]' pyproject.toml; then
            echo "::error::pyproject.toml still carries [tool.semantic_release] — the PSR flow (release.yml) is live and this knope flow is interlocked-inert. The Phase-2 swap that deletes the PSR block is the arming action."
            exit 1
          fi
          echo "interlock: no [tool.semantic_release] block — knope flow is armed"

      # Same pin + Renovate note as release-prepare.yml.
      - name: Install knope
        uses: knope-dev/action@v2.1.2
        with:
          version: 0.23.0

      # RELEASE_TOKEN (M1): a tag or release created with the workflow's own
      # GITHUB_TOKEN triggers NO downstream workflows (verified 0-for-10 in
      # the live spike), which would silence docs.yml's `release: published`
      # deploy and the notes flow.  The PAT keeps every event consumer
      # firing, exactly as today's PSR path does.
      - name: Guard, then tag and create the GitHub release
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
        run: knope tag-release --verbose
