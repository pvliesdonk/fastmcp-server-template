# Release-PR flow, half two of two (knope; fastmcp-server-template#406).
# Merge = release: when a release PR (head `knope/prepare/<base>`, opened by
# release-prepare.yml) merges, run knope's tag-release workflow on the PR's
# merge commit, then fan out the publishes.  Inside knope.toml the
# same-source promotion guard (scripts/promotion_guard.sh) runs BEFORE the
# Release step, so a guard refusal fails the release job with no tag created
# (release-vision section 4.4 — tags are immutable; a refusal must leave
# nothing behind).
#
# Prerelease-ness is a property of the reviewed diff, not of any dispatch
# flag: the version knope computed sits in the merged pyproject.toml, an
# `-rc.` suffix marks a pre-release, and every publish gate below derives
# from that (plus tag ordering) — a mismatched dispatch cannot open a
# stable-only gate for an rc, because there is no dispatch.
#
# Operator rules (load-bearing — see release-vision sections 4.2/4.4):
#   * NEVER use GitHub's "Update branch" button on a release PR — the only
#     refresh is re-dispatching Release Prepare.
#   * A branch release (base != default branch) is followed by the
#     port-bookkeeping job below, which opens an ordinary PR carrying the
#     changelog section to the default branch — there is no merge-back.
name: Release

on:
  pull_request:
    types: [closed]

permissions:
  contents: read

jobs:
  release:
    # Only merged release PRs; the head-ref prefix is the prep-branch
    # namespace release-prepare.yml creates (per base, so concurrent release
    # PRs on main and release/X.Y stay distinguishable here).  Defense in
    # depth on top of release-prepare.yml's own refusals: the head must
    # live in THIS repository (a fork branch named knope/prepare/* must not
    # trigger a release), and the base must itself be a releasable ref (the
    # default branch or release/*), mirroring the prepare-time gate.
    if: >-
      github.event.pull_request.merged == true &&
      startsWith(github.event.pull_request.head.ref, 'knope/prepare/') &&
      github.event.pull_request.head.repo.full_name == github.repository &&
      (github.event.pull_request.base.ref == github.event.repository.default_branch ||
       startsWith(github.event.pull_request.base.ref, 'release/'))
    runs-on: ubuntu-latest
    # Per-base buckets, mirroring release-prepare.yml's: a patch release off
    # release/X.Y must not serialise behind (or cancel) a release off main.
    # Cross-branch resources stay safe without a global bucket: the
    # GitHub-release/PyPI/registry writes are per-version, the marketplace
    # push rebase-retries, docs deploys serialise in docs.yml, and the
    # rolling Docker tags are ordering-gated below.
    concurrency:
      group: release-{% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
      cancel-in-progress: false
    timeout-minutes: 30

    permissions:
      contents: write
      id-token: write

    steps:
      - name: Checkout the release PR's merge commit (full depth, with tags)
        uses: actions/checkout@v7
        with:
          # The MERGE COMMIT, not the base branch head: a commit landing on
          # the base between merge and checkout must neither get tagged as
          # the release nor spuriously trip the promotion guard.  The merge
          # commit is exactly what "merging the release PR is the release"
          # promises to tag.
          ref: {% raw %}${{ github.event.pull_request.merge_commit_sha }}{% endraw %}
          # Full history + tags: the promotion guard diffs HEAD against the
          # highest reachable rc tag of the target version, and the ordering
          # step below compares the new tag against every stable.
          fetch-depth: 0
          fetch-tags: true

      # Swap-completeness guard (migration P1.0/P2): during the additive
      # phase this interlock kept the knope flow inert while
      # python-semantic-release was still the release path; the PSR config
      # block is gone now, so it always passes — and it stays here so the
      # two release models can never both be live again.  If this fails, a
      # `[tool.semantic_release]` block has reappeared in pyproject.toml.
      - name: Refuse while python-semantic-release is still the release path
        run: |
          if grep -q '^\[tool\.semantic_release\]' pyproject.toml; then
            echo "::error::pyproject.toml carries a [tool.semantic_release] block — the PSR and knope release flows must never both be live. Remove the block (the knope release-PR flow is this project's release path), or remove the knope machinery before resurrecting PSR."
            exit 1
          fi
          echo "interlock: no [tool.semantic_release] block — knope flow is armed"

      # The job-level `if` can only prefix-match the head (workflow
      # expressions cannot string-replace), so bind the head to the base
      # here: release-prepare.yml names the prep branch for base B exactly
      # `knope/prepare/<B with slashes as dashes>`, and a prep PR retargeted
      # at a DIFFERENT base — merging main's prep branch into release/X.Y,
      # say — must never be treated as that base's release decision: its
      # stamps and changelog were computed against another ancestry.
      - name: Refuse a prep head that does not match the PR's base
        env:
          HEAD_REF: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
          BASE_REF: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
        run: |
          expected="knope/prepare/${BASE_REF//\//-}"
          if [ "$HEAD_REF" != "$expected" ]; then
            echo "::error::merged head '${HEAD_REF}' is not the prep branch for base '${BASE_REF}' (expected '${expected}') — a retargeted release PR is not a release decision. Nothing was tagged; re-dispatch Release Prepare on '${BASE_REF}' for a reviewed release PR of its own."
            exit 1
          fi
          echo "prep head matches its base: ${HEAD_REF} <- ${BASE_REF}"

      # knope-dev/action installs the pinned knope CLI.  Renovate: the
      # action ref is covered by the template repo's jinja-workflow regex
      # manager, and the `version:` input below by its knope-cli regex
      # manager (github-releases, depName knope-dev/knope) — keep the
      # `version:` key on its own line so that manager keeps matching.
      - name: Install knope
        uses: knope-dev/action@v2.1.2
        with:
          version: 0.23.0

      # RELEASE_TOKEN (release-vision section 4.3): a tag or release created
      # with the workflow's own GITHUB_TOKEN triggers NO downstream
      # workflows (verified 0-for-10 in the live spike), which would silence
      # docs.yml's `release: published` deploy and the notes flow.  The PAT
      # keeps every event consumer firing.  Guard-before-Release ordering
      # lives in knope.toml's tag-release workflow.
      - name: Guard, then tag and create the GitHub release
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
        run: knope tag-release --verbose

      # Everything downstream derives from the merged, reviewed diff: the
      # version is what knope stamped into pyproject.toml (the tag is
      # v<version>), and prerelease-ness is the `-rc.` marker in it.  The
      # tag itself was created remotely by knope's Release step, so re-fetch
      # tags to make it visible to the ordering computation below.
      - name: Resolve the released version from the merged diff
        id: release
        run: |
          version="$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml | head -1)"
          if [ -z "$version" ]; then
            echo "::error::could not read a version from the merged pyproject.toml"
            exit 1
          fi
          tag="v${version}"
          case "$version" in
            *-rc.*) is_prerelease=true ;;
            *) is_prerelease=false ;;
          esac
          git fetch --tags --force origin
          git rev-parse -q --verify "refs/tags/${tag}" > /dev/null \
            || { echo "::error::knope tag-release reported success but tag ${tag} does not exist"; exit 1; }
          {
            echo "version=${version}"
            echo "tag=${tag}"
            echo "is_prerelease=${is_prerelease}"
          } >> "$GITHUB_OUTPUT"

      # A release from an old series must not repoint rolling channels at
      # older content: Docker `latest`/`vX`/`vX.Y`, the GitHub "latest
      # release" pointer, the marketplace entry, and the MCP registry all
      # follow ONLY when this release is the highest in the relevant series.
      # Tags are complete here: full-depth checkout plus the re-fetch above.
      - name: Determine channel ordering
        id: ordering
        env:
          TAG: {% raw %}${{ steps.release.outputs.tag }}{% endraw %}
          IS_PRERELEASE: {% raw %}${{ steps.release.outputs.is_prerelease }}{% endraw %}
        run: |
          is_latest=false
          is_latest_major=false
          is_latest_minor=false
          if [ "$IS_PRERELEASE" != "true" ]; then
            ver="${TAG#v}"
            major="${ver%%.*}"
            minor="${ver%.*}"
            stable=$(git tag --list | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$')
            if [ "$(printf '%s\n' "$stable" | sort -V | tail -1)" = "$TAG" ]; then
              is_latest=true
            fi
            if [ "$(printf '%s\n' "$stable" | grep -E "^v${major}\." | sort -V | tail -1)" = "$TAG" ]; then
              is_latest_major=true
            fi
            if [ "$(printf '%s\n' "$stable" | grep -E "^v${minor//./\\.}\." | sort -V | tail -1)" = "$TAG" ]; then
              is_latest_minor=true
            fi
          fi
          {
            echo "is_latest=$is_latest"
            echo "is_latest_major=$is_latest_major"
            echo "is_latest_minor=$is_latest_minor"
          } >> "$GITHUB_OUTPUT"

      # Release-body contract (template#350, reworked for the release-PR
      # flow): knope's Release step already set the body to the release's
      # machine changelog section; this step appends the pointers.  For a
      # stable, the notes deep link is CONDITIONAL on the series page
      # existing on the default branch at publish time — notes merged during
      # the rc window (migration M6 admits them into the promotion diff) get
      # their deep link right here.  The link resolves regardless of the cut
      # branch because docs.yml's release deploy overlays the default
      # branch's docs/releases/ into the deployed minor — the tag itself
      # (a release/X.Y cut above all) may carry none of the pages.  A
      # stable published before its notes PR
      # merges instead gets plain pointers plus the invisible
      # `<!-- release-notes-pending -->` marker: release-notes-publish.yml
      # upgrades ONLY bodies carrying that marker (opt-in) and removes it in
      # the upgrade, so a hand-edited body is never clobbered — the marker
      # literal appears on both sides; reword them together.  rc bodies
      # never promise a notes page: the rc cycle's content lands in the
      # minor's page for the stable.
      - name: Append release-body pointers (docs, compare, changelog)
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          TAG: {% raw %}${{ steps.release.outputs.tag }}{% endraw %}
          IS_PRERELEASE: {% raw %}${{ steps.release.outputs.is_prerelease }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          DEFAULT: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
        run: |
          ver="${TAG#v}"
          minor="${ver%%-*}"
          minor="${minor%.*}"
          # Highest stable tag strictly below this release (series-aware via
          # sort -V; empty on a project's very first release).
          prev=$(
            { git tag --list | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
                | grep -Fvx "$TAG"; echo "$TAG"; } \
              | sort -V | awk -v t="$TAG" '$0 == t { print p; exit } { p = $0 }'
          )
          body=$(gh release view "$TAG" --json body --jq .body)
          notes_pending=""
          {
            if [ "$IS_PRERELEASE" = "true" ]; then
              echo "Release candidate ${ver}: a stabilisation build toward the upcoming v${minor} stable. Install it only to help test that release."
              echo
            fi
            printf '%s\n' "$body"
            echo
            if [ "$IS_PRERELEASE" = "true" ]; then
              # The stable's versioned docs publish when the stable ships;
              # rcs deploy no docs, so point at the site root instead of a
              # not-yet-existing /X.Y/ page.
              echo "- Documentation: https://{{ github_org }}.github.io/{{ project_name }}/ (the v${minor} pages publish when the stable ships)"
            else
              # The page check: pages live only on the default branch (a
              # branch-cut stable's tag does not carry them), so ask the
              # default branch, not the tag.
              if gh api --silent "repos/${REPO}/contents/docs/releases/${minor}.md?ref=${DEFAULT}" 2>/dev/null; then
                echo "- Release notes: https://{{ github_org }}.github.io/{{ project_name }}/${minor}/releases/${minor}/"
              else
                notes_pending=yes
              fi
              echo "- Documentation: https://{{ github_org }}.github.io/{{ project_name }}/${minor}/"
            fi
            if [ -n "$prev" ]; then
              echo "- All changes since ${prev}: https://github.com/${REPO}/compare/${prev}...${TAG}"
            fi
            echo "- Commit-level detail: [CHANGELOG.md](https://github.com/${REPO}/blob/${TAG}/CHANGELOG.md)"
            if [ -n "$notes_pending" ]; then
              # Invisible upgrade-once marker for release-notes-publish.yml.
              echo
              echo "<!-- release-notes-pending -->"
            fi
          } > release-body.md
          gh release edit "$TAG" --notes-file release-body.md

      # GitHub auto-marks the newest non-prerelease as the repo's "latest
      # release", which would repoint /releases/latest (and the versionless
      # .deb/.rpm URLs) at a backport patch cut after a newer stable. Demote it.
      - name: Keep the GitHub latest-release pointer ordered
        if: steps.release.outputs.is_prerelease == 'false' && steps.ordering.outputs.is_latest == 'false'
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: gh release edit {% raw %}${{ steps.release.outputs.tag }}{% endraw %} --latest=false

      - name: Install uv
        uses: astral-sh/setup-uv@v8.2.0
        with:
          version: "0.6"

      - name: Setup Python
        run: uv python install 3.12

      - name: Build package
        run: uv build

      - name: Generate SBOM
        uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610  # v0.24.0
        with:
          path: .
          format: cyclonedx-json
          output-file: sbom.cdx.json
          upload-artifact: false
          upload-release-assets: false

      - name: Upload SBOM and build artifacts to GitHub Release
        run: gh release upload {% raw %}${{ steps.release.outputs.tag }}{% endraw %} sbom.cdx.json dist/* --clobber
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Upload build artifacts
        uses: actions/upload-artifact@v7
        with:
          name: dist
          path: dist/

    outputs:
      # "true" only when the release job ran to a successful tag — the
      # single source every publish gate below derives from, so gate state
      # can never desync from what knope actually cut.
      released: {% raw %}${{ steps.release.outputs.tag != '' }}{% endraw %}
      version: {% raw %}${{ steps.release.outputs.version }}{% endraw %}
      tag: {% raw %}${{ steps.release.outputs.tag }}{% endraw %}
      is_prerelease: {% raw %}${{ steps.release.outputs.is_prerelease }}{% endraw %}
      is_latest: {% raw %}${{ steps.ordering.outputs.is_latest }}{% endraw %}
      is_latest_major: {% raw %}${{ steps.ordering.outputs.is_latest_major }}{% endraw %}
      is_latest_minor: {% raw %}${{ steps.ordering.outputs.is_latest_minor }}{% endraw %}

  publish-pypi:
    needs: release
    # Every stable, including a backport patch from an old release/X.Y: PyPI
    # versions are immutable and unordered, and installers pinned below a
    # newer major are exactly who a backport serves.
    if: needs.release.outputs.released == 'true' && needs.release.outputs.is_prerelease == 'false'
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/p/{{ pypi_name }}

    permissions:
      id-token: write

    steps:
      - name: Download build artifacts
        uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/

      - name: Publish to PyPI
        uses: pypa/gh-action-pypi-publish@cef221092ed1bacb1cc03d23a2d87d1d172e277b  # v1.14.0
        with:
          packages-dir: dist/
          print-hash: true
          verbose: true

  publish-docker:
    needs: release
    if: needs.release.outputs.released == 'true'
    runs-on: ubuntu-latest

    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write

    env:
      REGISTRY: ghcr.io
      IMAGE_NAME: {% raw %}${{ github.repository }}{% endraw %}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
          fetch-depth: 1

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Log in to Container Registry
        uses: docker/login-action@v4
        with:
          registry: {% raw %}${{ env.REGISTRY }}{% endraw %}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Extract version components
        id: version
        env:
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
        run: |
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "major=$(echo "$VERSION" | cut -d. -f1)" >> $GITHUB_OUTPUT
          echo "minor=$(echo "$VERSION" | cut -d. -f1-2)" >> $GITHUB_OUTPUT

      - name: Extract metadata (tags, labels)
        id: meta
        uses: docker/metadata-action@v6
        with:
          images: {% raw %}${{ env.REGISTRY }}{% endraw %}/{% raw %}${{ env.IMAGE_NAME }}{% endraw %}
          # Rolling tags are ordering-gated (see the release job): a backport
          # patch cut after a newer stable updates only the series tags it is
          # actually the newest member of, and never `latest`.  An rc pushes
          # its immutable version tag alone — the rolling `unstable` tag is
          # retired now that rcs are rare, branch-scoped stabilisation builds
          # ("run the latest code" is the `edge` tag, pushed per merge to main
          # by the Unstable channel workflow).
          tags: |
            type=raw,value=v{% raw %}${{ steps.version.outputs.version }}{% endraw %}
            type=raw,value=latest,enable={% raw %}${{ needs.release.outputs.is_latest == 'true' }}{% endraw %}
            type=raw,value=v{% raw %}${{ steps.version.outputs.minor }}{% endraw %},enable={% raw %}${{ needs.release.outputs.is_latest_minor == 'true' }}{% endraw %}
            type=raw,value=v{% raw %}${{ steps.version.outputs.major }}{% endraw %},enable={% raw %}${{ needs.release.outputs.is_latest_major == 'true' }}{% endraw %}
          labels: |
            org.opencontainers.image.title={{ project_name }}
            org.opencontainers.image.description={{ domain_description }}
            org.opencontainers.image.vendor={{ github_org }}
            io.modelcontextprotocol.server.name=io.github.{{ github_org }}/{{ project_name }}

      - name: Build and push Docker image
        id: build-push
        uses: docker/build-push-action@v7
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Generate artifact attestation
        uses: actions/attest-build-provenance@v4
        with:
          subject-name: {% raw %}${{ env.REGISTRY }}{% endraw %}/{% raw %}${{ env.IMAGE_NAME }}{% endraw %}
          subject-digest: {% raw %}${{ steps.build-push.outputs.digest }}{% endraw %}
          push-to-registry: true

      - name: Generate SBOM for Docker image
        uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610  # v0.24.0
        with:
          image: {% raw %}${{ env.REGISTRY }}{% endraw %}/{% raw %}${{ env.IMAGE_NAME }}{% endraw %}@{% raw %}${{ steps.build-push.outputs.digest }}{% endraw %}
          format: cyclonedx-json
          output-file: sbom-docker.cdx.json
          upload-artifact: false
          upload-release-assets: false

      - name: Attest Docker SBOM
        uses: actions/attest-sbom@v4
        with:
          subject-name: {% raw %}${{ env.REGISTRY }}{% endraw %}/{% raw %}${{ env.IMAGE_NAME }}{% endraw %}
          subject-digest: {% raw %}${{ steps.build-push.outputs.digest }}{% endraw %}
          sbom-path: sbom-docker.cdx.json
          push-to-registry: true

  publish-linux-packages:
    needs: release
    if: needs.release.outputs.released == 'true' && needs.release.outputs.is_prerelease == 'false'
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
          fetch-depth: 1

      - name: Create output directory
        run: mkdir -p dist

      - name: Bake package version into postinstall script
        env:
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
        run: sed -i "s|\${VERSION:-}|${VERSION}|" packaging/scripts/postinstall.sh

      - name: Build .deb package
        uses: burningalchemist/action-gh-nfpm@eeac96f42da23d091eec0d0088bf05cac0ceb9f3  # v1
        id: deb
        with:
          nfpm_version: "2.41.1"
          packager: deb
          config: packaging/nfpm.yaml
          target: dist/
        env:
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
          ARCH: amd64

      - name: Build .rpm package
        uses: burningalchemist/action-gh-nfpm@eeac96f42da23d091eec0d0088bf05cac0ceb9f3  # v1
        id: rpm
        with:
          nfpm_version: "2.41.1"
          packager: rpm
          config: packaging/nfpm.yaml
          target: dist/
        env:
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
          ARCH: x86_64

      - name: Create versionless copies for stable download URLs
        run: |
          cp dist/{{ project_name }}_*.deb dist/{{ project_name }}_latest.deb
          cp dist/{{ project_name }}-*.rpm dist/{{ project_name }}_latest.rpm

      - name: Upload packages to GitHub Release
        run: gh release upload {% raw %}${{ needs.release.outputs.tag }}{% endraw %} dist/*.deb dist/*.rpm --clobber
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

  build-mcpb:
    needs: release
    if: needs.release.outputs.released == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
      # Render/validate/pack/smoke live in the shared composite action so
      # the pre-release-check workflow exercises the exact same steps a
      # real release runs (#331).
      - name: Build and smoke-test mcpb bundle
        uses: ./.github/actions/build-mcpb
        with:
          version: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
      - uses: actions/upload-artifact@v7
        with:
          name: mcpb-bundle
          path: dist/{{ project_name }}-*.mcpb
          if-no-files-found: error

  publish-mcpb:
    needs: [release, build-mcpb]
    if: needs.release.outputs.released == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: mcpb-bundle
          path: dist/
      - name: Upload to GitHub Release
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          gh release upload \
            "{% raw %}${{ needs.release.outputs.tag }}{% endraw %}" \
            dist/{{ project_name }}-*.mcpb \
            --clobber \
            --repo "{% raw %}${{ github.repository }}{% endraw %}"

  # Publishes the marketplace catalog entry by committing straight to the
  # catalog's default branch — a release must not end at an open PR awaiting
  # a human merge (fastmcp-server-template#333; 15 such PRs once went stale).
  # The plugin-artifact check guards against publishing a git-subdir entry
  # whose path does not exist at the tag, which is uninstallable; projects
  # without a .claude-plugin/plugin directory skip with a warning rather
  # than failing the release.
  publish-claude-plugin:
    needs: release
    # `is_latest` keeps the single marketplace entry ordered: a backport patch
    # from an old series must not repoint the catalog at older content.
    if: needs.release.outputs.released == 'true' && needs.release.outputs.is_prerelease == 'false' && needs.release.outputs.is_latest == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Check plugin artifact exists at tag
        id: plugin_check
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          TAG: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
        run: |
          if gh api --silent \
            "repos/{% raw %}${{ github.repository }}{% endraw %}/contents/.claude-plugin/plugin/.claude-plugin/plugin.json?ref=${TAG}"
          then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
            echo "::warning::.claude-plugin/plugin missing at ${TAG} — skipping marketplace publish; a git-subdir entry pointing at a missing path would be uninstallable"
          fi
      - name: Checkout catalog repo
        if: steps.plugin_check.outputs.present == 'true'
        uses: actions/checkout@v7
        with:
          repository: {{ github_org }}/claude-plugins
          token: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
          path: catalog
      - name: Bump marketplace.json entry
        if: steps.plugin_check.outputs.present == 'true'
        env:
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
        run: |
          cd catalog
          NEW_ENTRY=$(jq -n \
            --arg name    "{{ project_name }}" \
            --arg url     "https://github.com/{{ github_org }}/{{ project_name }}.git" \
            --arg ref     "v$VERSION" \
            --arg version "$VERSION" \
            '{
              name: $name,
              source: {
                source: "git-subdir",
                url: $url,
                path: ".claude-plugin/plugin",
                ref: $ref
              },
              version: $version
            }')
          jq --arg name "{{ project_name }}" \
             --arg v    "$VERSION" \
             --arg ref  "v$VERSION" \
             --argjson new "$NEW_ENTRY" '
            .plugins |= (
              if any(.[]; .name == $name)
              then map(if .name == $name then .version = $v | .source.ref = $ref else . end)
              else . + [$new]
              end
            )
          ' marketplace.json > marketplace.json.tmp
          mv marketplace.json.tmp marketplace.json
          # The catalog must never be pushed malformed or with a mismatched
          # entry: validate before anything is committed.
          jq empty marketplace.json
          jq -e --arg name "{{ project_name }}" --arg v "$VERSION" '
            .plugins[] | select(.name == $name)
            | select(.version == $v and .source.ref == ("v" + $v))
          ' marketplace.json > /dev/null
      - name: Commit and push to catalog
        if: steps.plugin_check.outputs.present == 'true'
        env:
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
        run: |
          cd catalog
          if git diff --quiet -- marketplace.json; then
            echo "marketplace.json already at v${VERSION}; nothing to publish"
            exit 0
          fi
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          BRANCH=$(git rev-parse --abbrev-ref HEAD)
          git add marketplace.json
          git commit -m "chore: bump {{ project_name }} to v${VERSION}"
          # Concurrent sibling releases race on the same file; rebase-retry
          # instead of failing. Bumping existing entries touches distinct
          # lines and rebases cleanly; only two simultaneous *first*
          # releases (both appending at the array tail) can conflict, and
          # that fails loudly below for a manual job re-run.
          for attempt in 1 2 3 4 5; do
            if git push origin "HEAD:${BRANCH}"; then
              exit 0
            fi
            if ! git pull --rebase origin "${BRANCH}"; then
              git rebase --abort || true
              echo "::error::concurrent catalog change conflicts with this bump; re-run this job"
              exit 1
            fi
          done
          echo "::error::could not push marketplace bump after 5 attempts"
          exit 1

  publish-registry:
    needs: [release, publish-pypi, publish-docker]
    # `is_latest` for the same reason as the marketplace: the registry entry
    # is a discovery surface for the newest release; a backport's audience
    # already holds pins and installs from PyPI or GitHub releases.
    if: needs.release.outputs.released == 'true' && needs.release.outputs.is_prerelease == 'false' && needs.release.outputs.is_latest == 'true'
    runs-on: ubuntu-latest

    permissions:
      contents: read
      id-token: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7
        with:
          # The released ref, not a branch: the release commit — with the
          # stamped server.json this job publishes — lives on whatever branch
          # the release was cut from, and mid-cycle `main` may carry a
          # different version entirely.
          ref: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
          fetch-depth: 1

      - name: Install mcp-publisher
        env:
          # v1.7.x is the first that requests the per-deployment OIDC audience
          # the registry now requires (PR modelcontextprotocol/registry#1229,
          # merged 2026-04-30 — production registry expects audience
          # `https://registry.modelcontextprotocol.io`; v1.5.0 still requests
          # `mcp-registry` and fails token exchange with HTTP 401).
          MCP_PUBLISHER_VERSION: v1.7.6
          MCP_PUBLISHER_SHA256: bcc96ca630cae4cf503b4550bd4a17462d42ad4819273bee56f4385bb059ddee
        run: |
          curl -sL "https://github.com/modelcontextprotocol/registry/releases/download/${MCP_PUBLISHER_VERSION}/mcp-publisher_linux_amd64.tar.gz" -o mcp-publisher.tar.gz
          echo "${MCP_PUBLISHER_SHA256}  mcp-publisher.tar.gz" | sha256sum -c
          tar xz -f mcp-publisher.tar.gz mcp-publisher

      - name: Authenticate to MCP Registry
        run: ./mcp-publisher login github-oidc

      - name: Publish to MCP Registry
        run: ./mcp-publisher publish

  # Branch-release bookkeeping (release-vision section 4.5): after a STABLE
  # release cut from a branch other than the default one, the default branch
  # still wants the changelog section (and the notes-page delta, which in
  # practice never exists — notes pages only ever land on the default
  # branch).  That ports over as an ORDINARY pull request, opened with
  # RELEASE_TOKEN so its CI runs — no admin-bypass push, no merge-back, and
  # nothing deadlocks if it merges late.  Stables only: knope's stable
  # section is cumulative over the whole rc cycle, so porting per rc would
  # only manufacture pairwise conflicts and duplicate entries for content
  # the stable's port carries anyway.  The version stamps are deliberately
  # NOT ported (the default branch's pyproject.toml and manifests describe
  # its own series) — which is why release-prepare.yml refuses a computed
  # version whose tag already exists repo-globally.  A CHANGELOG.md whose
  # flag line or section boundaries have drifted fails this job loudly; the
  # remedy is a hand-opened PR carrying the section.
  port-bookkeeping:
    needs: release
    if: >-
      needs.release.outputs.released == 'true' &&
      needs.release.outputs.is_prerelease == 'false' &&
      github.event.pull_request.base.ref != github.event.repository.default_branch
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout default branch
        uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          fetch-depth: 0
          # PAT, so the branch push and PR below trigger CI on the port PR
          # (GITHUB_TOKEN-created PRs run no workflows and could never pass
          # the required CI Success check).
          token: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}

      - name: Open the bookkeeping port PR
        env:
          GH_TOKEN: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
          TAG: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
          VERSION: {% raw %}${{ needs.release.outputs.version }}{% endraw %}
          MERGE_SHA: {% raw %}${{ github.event.pull_request.merge_commit_sha }}{% endraw %}
          BASE: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
          DEFAULT: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          set -euo pipefail
          git fetch -q origin "$MERGE_SHA"
          # Extract this release's changelog section from the released
          # commit: its `## <version>` heading up to (not including) the
          # next `## ` heading.
          git show "${MERGE_SHA}:CHANGELOG.md" > /tmp/released-changelog.md
          # Escape the version's dots INSIDE awk (an escaped `-v` value
          # would be mangled by awk's own escape processing), so the
          # heading regex here and the dedup grep below match identically —
          # neither treats `4.1.0` as also matching `4x1y0`.
          awk -v ver="$VERSION" '
            BEGIN { gsub(/\./, "\\.", ver); re = "^## v?" ver "([ (]|$)" }
            $0 ~ re { found=1; print; next }
            found && /^## / { exit }
            found { print }
          ' /tmp/released-changelog.md > /tmp/section.md
          if ! [ -s /tmp/section.md ]; then
            echo "::error::could not find the ## ${VERSION} section in the released CHANGELOG.md — port the changelog section to ${DEFAULT} by hand (ordinary PR)"
            exit 1
          fi
          if grep -qE "^## v?${VERSION//./\\.}([ (]|\$)" CHANGELOG.md; then
            echo "${DEFAULT}'s CHANGELOG.md already carries the ${VERSION} section — nothing to port"
            exit 0
          fi
          # Insert directly below the insertion flag: newest-inserted-first
          # matches release chronology (a backport releases after the newer
          # stables above it were inserted).
          if ! grep -qF '<!-- version list -->' CHANGELOG.md; then
            echo "::error::${DEFAULT}'s CHANGELOG.md has no '<!-- version list -->' flag line — port the ${VERSION} section by hand (ordinary PR)"
            exit 1
          fi
          awk 'BEGIN { while ((getline line < "/tmp/section.md") > 0) sec = sec line "\n" }
               { print }
               $0 == "<!-- version list -->" { printf "\n%s", sec }' \
            CHANGELOG.md > CHANGELOG.md.new
          mv CHANGELOG.md.new CHANGELOG.md
          git config user.name "github-actions"
          git config user.email "actions@users.noreply.github.com"
          BRANCH="knope/port/${TAG}"
          git switch --force-create "$BRANCH"
          git add CHANGELOG.md
          git commit -m "chore: port ${TAG} release bookkeeping to ${DEFAULT}"
          git push --force origin "HEAD:${BRANCH}"
          # Skip cleanly when a port PR is already open (the force-push just
          # refreshed it); otherwise create WITHOUT masking failures — a
          # 403 or API error must fail this job loudly, per its contract.
          existing="$(gh pr list --head "$BRANCH" --base "$DEFAULT" --state open --json number --jq 'length')"
          if [ "$existing" != "0" ]; then
            echo "port PR for ${BRANCH} already open — the force-push refreshed it"
            exit 0
          fi
          gh pr create --base "$DEFAULT" --head "$BRANCH" \
            --title "chore: port ${TAG} release bookkeeping to ${DEFAULT}" \
            --body "Ports the ${TAG} changelog section from \`${BASE}\` to \`${DEFAULT}\` after the branch release ([release](https://github.com/${REPO}/releases/tag/${TAG})). Version stamps are deliberately not ported — ${DEFAULT}'s manifests describe its own series. Ordinary PR: review and merge on its own clock; conflicts (if the insertion drifted) are resolved by hand."
