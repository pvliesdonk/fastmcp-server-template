"""Resource registrations for {{ human_name }}.

Docstrings here are model-facing wire text; what belongs in one is
decided by the ``writing-model-facing-text`` skill on the evidence in
``docs/design/reference/mcp-model-facing-text.md``.

See FastMCP resource docs: https://gofastmcp.com/servers/resources
"""

from __future__ import annotations

from fastmcp import FastMCP
from fastmcp.dependencies import Depends

from {{ python_module }}._server_deps import get_service
from {{ python_module }}.domain import Service


def register_resources(mcp: FastMCP) -> None:
    """Register all domain resources on *mcp*."""

    # Templated resources take path parameters in the URI; static resources
    # don't (https://gofastmcp.com/servers/resources#templates).  The
    # docstring is the description a client lists next to the URI, so it
    # says what the resource contains and nothing about how it is built
    # (see the ``writing-model-facing-text`` skill).
    @mcp.resource("status://{{ project_name }}")
    async def status(service: Service = Depends(get_service)) -> dict[str, object]:
        """Current service status."""
        return await service.status()
