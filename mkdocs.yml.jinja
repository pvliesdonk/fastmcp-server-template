site_name: {{ project_name }}
site_url: https://{{ github_org }}.github.io/{{ project_name }}/
site_description: "{{ domain_description }}"
repo_url: https://github.com/{{ github_org }}/{{ project_name }}
repo_name: {{ github_org }}/{{ project_name }}
edit_uri: edit/main/docs/

# Internal dev docs live under docs/ but are NOT part of the published site.
# Keep this set in lockstep with the Vale exclusion (ci.yml's `glob:` input +
# the pre-commit `- id: vale` exclude); see the Documentation Conventions
# section in AGENTS.md. superpowers/ is also gitignored.
exclude_docs: |
  design/**
  decisions/**
  releases/next.md
  superpowers/**

theme:
  name: material
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: Switch to dark mode
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: Switch to light mode
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.expand
    - navigation.top
    - search.suggest
    - search.highlight
    - content.code.copy
    - content.tabs.link
  icon:
    repo: fontawesome/brands/github

extra:
  version:
    provider: mike
    default: latest

extra_javascript:
  - path: javascripts/config-wizard/wizard.js
    type: module

extra_css:
  - stylesheets/config-wizard.css

plugins:
  - search
  # Keeps a moved page's old URL working. The entries above the project
  # block are the template's own moves; a project that moves one of its
  # pages adds `old-page.md: new-page.md` inside the block.
  - redirects:
      redirect_maps:
        configuration.md: reference/configuration.md
        configuration-generator.md: reference/configuration-generator.md
        tools/index.md: reference/tools/index.md
        prompts.md: reference/prompts.md
        # PROJECT-REDIRECTS-START — this project's moved pages; kept across copier update
        # PROJECT-REDIRECTS-END
  # Generates llms.txt + llms-full.txt for the README badge.
  # The sections are filled from `nav:` at build time by
  # scripts/llmstxt_sections_hook.py (registered under `hooks:`): one section
  # per top-level nav entry, pages outside the nav joining the section of a
  # nav page in their directory, descriptions from each page's `description:`
  # front matter. Nothing to keep in step by hand.
  - llmstxt:
      full_output: llms-full.txt
      sections: {}
  - mkdocstrings:
      handlers:
        python:
          paths: [src]
          options:
            show_source: false
            show_bases: true
            show_root_heading: true
            show_root_full_path: false
            heading_level: 2
            members_order: source
            docstring_style: google
            merge_init_into_class: true
            show_if_no_docstring: false

markdown_extensions:
  - admonition
  - pymdownx.details
  - pymdownx.superfences
  - pymdownx.highlight:
      anchor_linenums: false
  - pymdownx.inlinehilite
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.snippets
  - tables
  - toc:
      permalink: true
  - attr_list
  - md_in_html

hooks:
  - scripts/llmstxt_sections_hook.py

nav:
  - Overview: index.md
  - Security model: guides/security-model.md
  - Get started:
      - Installation: installation.md
      - Claude Desktop: deployment/claude-desktop.md
      # PROJECT-NAV-GET-STARTED-START — this server's first-run pages; kept across copier update
      # PROJECT-NAV-GET-STARTED-END
  - Deploy:
      - Docker: deployment/docker.md
      - Authentication: guides/authentication.md
      - OIDC: deployment/oidc.md
{% if enable_authorization %}      - Authorization: guides/authorization.md
{% endif %}      # PROJECT-NAV-DEPLOY-START — this server's deployment additions; kept across copier update
      # PROJECT-NAV-DEPLOY-END
  - Use:
      - Overview: use/index.md
      # PROJECT-NAV-USE-START — this server's how-tos and explanations (docs/use/); kept across copier update
      # PROJECT-NAV-USE-END
  # Reference is generated from the code by scripts/gen_reference.py; a fact
  # on these pages changes at its source (docstring, annotation, CLI help).
  - Reference:
      - Configuration: reference/configuration.md
      - Configuration generator: reference/configuration-generator.md
      - Tools:
          - Overview: reference/tools/index.md
          # GENERATED-NAV-TOOLS-START — one entry per tool group; written by scripts/gen_reference.py
          - Tools: reference/tools/tools.md
{% if include_mcp_apps_scaffold %}          - Server apps: reference/tools/server_apps.md
{% endif %}          - Server info: reference/tools/server_info.md
          # GENERATED-NAV-TOOLS-END
      - Resources: reference/resources.md
      - Prompts: reference/prompts.md
      - Command line: reference/cli.md
      # PROJECT-NAV-REFERENCE-START — resources, CLI, API reference (docs/reference/api/); kept across copier update
      # PROJECT-NAV-REFERENCE-END
  # Landing page only, deliberately: per-minor pages stay out of nav so a new
  # release never needs a nav edit (mkdocs treats not-in-nav pages as INFO,
  # so `--strict` stays green); the landing page and search link them.
  - Upgrade:
      - Release notes: releases/index.md
      # PROJECT-NAV-UPGRADE-START — kept across copier update
      # PROJECT-NAV-UPGRADE-END
  - Contribute:
      - Documentation structure: contribute/docs-structure.md
      - Release process: deployment/release-process.md
      - Template updates: deployment/template-updates.md
      - Repository protection: deployment/repository-protection.md
      - Integration branches: deployment/integration-branches.md
      # PROJECT-NAV-CONTRIBUTE-START — kept across copier update
      # PROJECT-NAV-CONTRIBUTE-END
  # PROJECT-NAV-UNSORTED-START — entries the nav migration could not place; move each into a section above
  # PROJECT-NAV-UNSORTED-END
